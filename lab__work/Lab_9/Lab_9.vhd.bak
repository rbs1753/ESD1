entity audio_filter is
  Port (clk, reset_n : in std_logic;
        write : in std_logic;
        address : in std_logic;
        writedata : in std_logic_vector(15 downto 0);
        readdata :out std_logic_vector(15 downto 0)
        );
end audio_filter;

